{
  // ─────────────────────────────────────────────────────────────
  // Vim: leader, portapapeles, colores de barra (Catppuccin Mocha)
  // ─────────────────────────────────────────────────────────────
  "vim.leader": "space",
  "vim.useSystemClipboard": true,
  "vim.overrideCopy": true,
  "vim.gdefault": true,
  "vim.showcmd": true,
  "vim.neovimPath": "/usr/bin/nvim",
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": ["#313244", "#cdd6f4"],
  "vim.statusBarColors.insert": ["#a6e3a1", "#1e1e2e"],
  "vim.statusBarColors.visual": ["#b4befe", "#1e1e2e"],
  "vim.statusBarColors.visualblock": ["#89b4fa", "#1e1e2e"],
  "vim.statusBarColors.visualline": ["#45475a", "#cdd6f4"],
  "vim.statusBarColors.replace": ["#fab387", "#1e1e2e"],
  "vim.statusBarColors.commandlineinprogress": ["#f9e2af", "#1e1e2e"],
  "vim.statusBarColors.searchinprogressmode": ["#f38ba8", "#1e1e2e"],
  // ─────────────────────────────────────────────────────────────
  // Vim: resaltados de búsqueda, yank, sustitución
  // ─────────────────────────────────────────────────────────────
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.searchHighlightColor": "rgba(180, 190, 254, 0.22)",
  "vim.searchHighlightTextColor": "#b4befe",
  "vim.searchMatchColor": "rgba(137, 180, 250, 0.35)",
  "vim.searchMatchTextColor": "#89b4fa",
  "vim.substitutionColor": "rgba(166, 227, 161, 0.28)",
  "vim.substitutionTextColor": "#a6e3a1",
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.color": "rgba(180, 190, 254, 0.35)",
  "vim.highlightedyank.duration": 200,
  // ─────────────────────────────────────────────────────────────
  // Vim: opciones estilo Neovim
  // ─────────────────────────────────────────────────────────────
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.inccommand": "replace",
  "vim.wrapscan": true,
  "vim.smartRelativeLine": true,
  "vim.startInInsertMode": false,
  "vim.startofline": true,
  "vim.whichwrap": "b,s,<,>,h,l",
  "vim.joinspaces": true,
  "vim.matchpairs": "(:),{:},[:]",
  "vim.iskeyword": "@,48-57,_,192-255,-",
  "vim.timeout": 300,
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-z>": false
  },
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.visual": "block",
  "vim.cursorStylePerMode.visualblock": "block",
  "vim.cursorStylePerMode.insert": "line-thin",
  "vim.cursorStylePerMode.replace": "underline",
  // ─────────────────────────────────────────────────────────────
  // Vim: textobjects, surround, motions (equivalentes a plugins de LazyVim)
  // ─────────────────────────────────────────────────────────────
  "vim.textwidth": 80,
  "vim.surround": true,
  "vim.changeWordIncludesWhitespace": true,
  "vim.visualstar": true,
  "vim.replaceWithRegister": true,
  "vim.mouseSelectionGoesIntoVisualMode": true,
  "vim.argumentObjectOpeningDelimiters": ["(", "[", "{"],
  "vim.argumentObjectClosingDelimiters": [")", "]", "}"],
  "vim.argumentObjectSeparators": [",", ";"],
  // ─────────────────────────────────────────────────────────────
  // Vim: easymotion + sneak (equivalentes a flash.nvim)
  // ─────────────────────────────────────────────────────────────
  "vim.easymotion": true,
  "vim.easymotionDimBackground": false,
  "vim.easymotionDimColor": "#585b70",
  "vim.easymotionKeys": "hklyuiopnm,qwertzxcjkl;",
  "vim.easymotionMarkerForegroundColorOneChar": "#f38ba8",
  "vim.easymotionMarkerForegroundColorTwoCharFirst": "#fab387",
  "vim.easymotionMarkerForegroundColorTwoCharSecond": "#f9e2af",
  "vim.easymotionIncSearchForegroundColor": "#a6e3a1",
  "vim.sneak": true,
  "vim.sneakReplacesF": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.camelCaseMotion.enable": true,
  // ─────────────────────────────────────────────────────────────
  // Vim: remapeos dentro de settings.json (esquema before/commands)
  // Los chords de leader (space ...) van en keybindings.json
  // ─────────────────────────────────────────────────────────────
  "vim.normalModeKeyBindings": [
    {
      "before": ["s", "v"],
      "commands": ["workbench.action.duplicateActiveEditorGroupRight"]
    },
    {
      "before": ["s", "s"],
      "commands": ["workbench.action.duplicateActiveEditorGroupDown"]
    },
    {
      "before": ["Z", "Z"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["Z", "Q"],
      "commands": ["workbench.action.closeActiveEditor"]
    }
  ],
  // ─────────────────────────────────────────────────────────────
  // Editor: Para esto sube <C-e> como equivalente a CTRL-D
  // ─────────────────────────────────────────────────────────────
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', monospace",
  "editor.fontSize": 13,
  "editor.lineHeight": 22,
  "editor.fontLigatures": true,
  "editor.letterSpacing": 0,
  // ─────────────────────────────────────────────────────────────
  // Editor: indentación como en init.lua de LazyVim
  // ─────────────────────────────────────────────────────────────
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.autoIndent": "full",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.acceptSuggestionOnEnter": "off",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.wordBasedSuggestions": "off",
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "inline",
  "editor.tabCompletion": "on",
  "editor.multiCursorModifier": "alt",
  "editor.wordSeparators": "@,48-57,_,192-255,-",
  "editor.linkedEditing": true,
  "editor.emptySelectionClipboard": true,
  "editor.rulers": [80],
  // ─────────────────────────────────────────────────────────────
  // Editor: visuales (reemplazan a indent-blankline / bufferline)
  // ─────────────────────────────────────────────────────────────
  "editor.lineNumbers": "relative",
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "selection",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.scrollBeyondLastLine": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.folding": true,
  "editor.foldingHighlight": true,
  "editor.showFoldingControls": "mouseover",
  "editor.gotoLocation": "floating",
  // ─────────────────────────────────────────────────────────────
  // Archivos
  // ─────────────────────────────────────────────────────────────
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/target": true,
    "**/dist": true,
    "**/build": true,
    "**/.dart_tool": true,
    "**/obj": true,
    "**/bin": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/target": true,
    "**/.git": true
  },
  "search.smartCase": true,
  // ─────────────────────────────────────────────────────────────
  // Workbench: terminal, tabs, explorer (comportamiento de LazyVim)
  // ─────────────────────────────────────────────────────────────
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enableFindAcrossFiles": true,
  "workbench.editor.limit": {
    "editor": 10,
    "debug": 5,
    "output": 3
  },
  "workbench.editor.emptySelectionClipboard": true,
  "workbench.commandPalette.history": 50,
  "workbench.settings.useSplitJSON": true,
  "workbench.sideBar.location": "left",
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "onHover",
  "explorer.compactFolders": false,
  "explorer.sortOrder": "default",
  "breadcrumbs.enabled": false,
  "scm.diffDecorations": "gutter",
  "problems.showCurrentInStatus": true,
  // ─────────────────────────────────────────────────────────────
  // Terminal integrada (equivalente a toggleterm + snacks)
  // ─────────────────────────────────────────────────────────────
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorWidth": 0.2,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "bottom",
  "workbench.startupEditor": "none",
  "workbench.colorCustomizations": {
    "statusBar.background": "#313244",
    "statusBar.noFolderBackground": "#313244",
    "statusBar.debuggingBackground": "#313244",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.debuggingForeground": "#cdd6f4"
  }
  // ─────────────────────────────────────────────────────────────
  // Neovim real como motor de keymaps (opcional, por defecto apagado)
  // Descomenta para que VSCodeVim use tu ~/.config/nvim/LazyVim.
  // Más fiel, pero lanza nvim headless: puede laggear o romperse
  // si tu config.lua tira un error.
  // ─────────────────────────────────────────────────────────────
  // "vim.enableNeovim": true,
  // "vim.neovimUseConfigFile": true,
  // "vim.neovimPath": "/usr/bin/nvim",
  // "vim.vimrc.enable": true,
  // "vim.vimrc.path": "/home/anthonyygpz/.config/nvim/init.lua"
}
